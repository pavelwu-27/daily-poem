      "author": "刘半农",
      "dynasty": "",
      "lines": [
        "天上飘着些微云，",
        "地上吹着些微风。",
        "啊！",
        "微风吹动了我头发，",
        "教我如何不想她？"
      ],
      "category": "modern",
      "theme": "思念",
      "theme_bg": "yearning"
